# Configurazione del convertitore. Copia questo file in ".env" e modifica solo ciò che serve.
# Tutti i valori hanno già un predefinito prudente: un file .env vuoto funziona.
# Il backend legge .env con "node --env-file-if-exists=.env" (vedi script "start" in package.json).

# ---------- Rete ----------
# Indirizzo di ascolto. 127.0.0.1 = solo questo computer. NON usare 0.0.0.0 senza leggere il README (sezione Privacy).
HOST=127.0.0.1
PORT=8080
# Obbligatorio "true" per accettare un HOST diverso da 127.0.0.1 / ::1 / localhost.
ALLOW_NON_LOOPBACK=false
# Nomi host aggiuntivi accettati nell'header Host (separati da virgola), oltre a 127.0.0.1, localhost e ::1.
ALLOWED_HOSTS=

# ---------- File temporanei ----------
# Directory dei job. Predefinito: <cartella temporanea di sistema>/md-converter
TEMP_DIR=
# Dopo quanti minuti di inattività un job viene eliminato.
JOB_TTL_MINUTES=60
# Ogni quanti secondi gira la pulizia periodica.
CLEANUP_INTERVAL_SECONDS=60
# Secondi di attesa, dopo il download di tutti i risultati, prima di eliminare il job.
CLEANUP_AFTER_DOWNLOAD_SECONDS=300

# ---------- Limiti ----------
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SIZE_MB=200
MAX_FILES_PER_JOB=20
# Numero massimo di job aperti contemporaneamente (schede del browser).
MAX_ACTIVE_JOBS=10
# Conversioni eseguite in parallelo. Predefinito: 2 (o 1 su macchine con un solo core).
MAX_CONCURRENT_JOBS=2
# Tempo massimo per la conversione di un singolo file (secondi).
CONVERSION_TIMEOUT_SECONDS=300
# Dimensione massima di un risultato.
MAX_OUTPUT_SIZE_MB=200
# Oltre questa somma le immagini Base64 non vengono incorporate: si passa alla cartella images/.
MAX_EMBEDDED_IMAGES_MB=10

# ---------- OCR ----------
# Lingue Tesseract che l'utente può scegliere (codici a 3 lettere, separati da virgola).
OCR_LANGUAGES=ita,eng
# Processi Tesseract in parallelo per ogni PDF (OCR = uso intenso di CPU).
OCR_JOBS=1

# ---------- Percorsi degli strumenti (facoltativi) ----------
# Se vuoti vengono cercati nel PATH e nelle posizioni tipiche del sistema operativo.
# Esempi Windows: C:\Program Files\Pandoc\pandoc.exe   C:\Program Files\LibreOffice\program\soffice.com
# Esempio macOS:  /Applications/LibreOffice.app/Contents/MacOS/soffice
PANDOC_PATH=
LIBREOFFICE_PATH=
TESSERACT_PATH=
OCRMYPDF_PATH=

# ---------- Varie ----------
# Directory del frontend compilato. Predefinito: apps/frontend/dist
FRONTEND_DIST_DIR=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
